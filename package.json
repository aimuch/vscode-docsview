{
  "name": "docsview",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.10.0",
  "publisher": "docsview",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aimuch/vscode-docsview.git"
  },
  "homepage": "https://github.com/aimuch/vscode-docsview#readme",
  "bugs": {
    "url": "https://github.com/aimuch/vscode-docsview/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "excel",
    "xlsx",
    "csv",
    "word",
    "docx",
    "pdf",
    "pptx",
    "jsonl",
    "epub",
    "zip",
    "image",
    "bbox",
    "preview"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "docsview.markdown",
        "displayName": "%editor.markdown%",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "docsview.csv",
        "displayName": "%editor.csv%",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "docsview.excel",
        "displayName": "%editor.excel%",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          },
          {
            "filenamePattern": "*.xls"
          },
          {
            "filenamePattern": "*.ods"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "docsview.word",
        "displayName": "%editor.word%",
        "selector": [
          {
            "filenamePattern": "*.docx"
          },
          {
            "filenamePattern": "*.doc"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "docsview.pdf",
        "displayName": "%editor.pdf%",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "docsview.pptx",
        "displayName": "%editor.pptx%",
        "selector": [
          {
            "filenamePattern": "*.pptx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "docsview.image",
        "displayName": "%editor.image%",
        "selector": [
          { "filenamePattern": "*.png" },
          { "filenamePattern": "*.jpg" },
          { "filenamePattern": "*.jpeg" },
          { "filenamePattern": "*.webp" },
          { "filenamePattern": "*.gif" },
          { "filenamePattern": "*.bmp" },
          { "filenamePattern": "*.svg" },
          { "filenamePattern": "*.ico" },
          { "filenamePattern": "*.avif" }
        ],
        "priority": "default"
      },
      {
        "viewType": "docsview.jsonl",
        "displayName": "%editor.jsonl%",
        "selector": [
          { "filenamePattern": "*.jsonl" },
          { "filenamePattern": "*.ndjson" }
        ],
        "priority": "option"
      },
      {
        "viewType": "docsview.epub",
        "displayName": "%editor.epub%",
        "selector": [
          { "filenamePattern": "*.epub" }
        ],
        "priority": "default"
      },
      {
        "viewType": "docsview.archive",
        "displayName": "%editor.archive%",
        "selector": [
          { "filenamePattern": "*.zip" },
          { "filenamePattern": "*.tar" },
          { "filenamePattern": "*.tar.gz" },
          { "filenamePattern": "*.tgz" },
          { "filenamePattern": "*.vsix" },
          { "filenamePattern": "*.whl" },
          { "filenamePattern": "*.jar" },
          { "filenamePattern": "*.apk" },
          { "filenamePattern": "*.nupkg" }
        ],
        "priority": "default"
      },
      {
        "viewType": "docsview.database",
        "displayName": "%editor.database%",
        "selector": [
          { "filenamePattern": "*.sqlite" },
          { "filenamePattern": "*.sqlite3" },
          { "filenamePattern": "*.db" },
          { "filenamePattern": "*.parquet" }
        ],
        "priority": "default"
      },
      {
        "viewType": "docsview.media",
        "displayName": "%editor.media%",
        "selector": [
          { "filenamePattern": "*.mp3" },
          { "filenamePattern": "*.wav" },
          { "filenamePattern": "*.ogg" },
          { "filenamePattern": "*.m4a" },
          { "filenamePattern": "*.flac" },
          { "filenamePattern": "*.mp4" },
          { "filenamePattern": "*.webm" },
          { "filenamePattern": "*.mov" }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "docsview.showPreview",
        "title": "%command.showPreview%",
        "icon": {
          "light": "media/icons/preview-light.svg",
          "dark": "media/icons/preview-dark.svg"
        }
      },
      {
        "command": "docsview.showPreviewToSide",
        "title": "%command.showPreviewToSide%",
        "icon": {
          "light": "media/icons/preview-side-light.svg",
          "dark": "media/icons/preview-side-dark.svg"
        }
      },
      {
        "command": "docsview.showSource",
        "title": "%command.showSource%",
        "icon": {
          "light": "media/icons/source-light.svg",
          "dark": "media/icons/source-dark.svg"
        }
      },
      {
        "command": "docsview.showHistory",
        "title": "%command.showHistory%"
      },
      {
        "command": "docsview.ai.openAssistant",
        "title": "%command.ai.openAssistant%",
        "icon": "$(sparkle)"
      },
      {
        "command": "docsview.ai.setApiKey",
        "title": "%command.ai.setApiKey%",
        "icon": "$(key)"
      },
      {
        "command": "docsview.ai.clearApiKey",
        "title": "%command.ai.clearApiKey%",
        "icon": "$(trash)"
      },
      {
        "command": "docsview.getViewerState",
        "title": "%command.getViewerState%"
      },
      {
        "command": "docsview.readDocumentMarkdown",
        "title": "%command.readDocumentMarkdown%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "docsview.showPreview",
          "when": "!activeCustomEditorId && resourceExtname =~ /^\\.(md|markdown|csv|tsv|jsonl|ndjson|svg)$/i",
          "group": "navigation@-100"
        },
        {
          "command": "docsview.showPreviewToSide",
          "when": "!activeCustomEditorId && resourceExtname =~ /^\\.(md|markdown|csv|tsv|jsonl|ndjson|svg)$/i",
          "group": "navigation@-99"
        },
        {
          "command": "docsview.showSource",
          "when": "activeCustomEditorId == 'docsview.markdown' || activeCustomEditorId == 'docsview.csv' || activeCustomEditorId == 'docsview.jsonl' || (activeCustomEditorId == 'docsview.image' && resourceExtname =~ /^\\.svg$/i)",
          "group": "navigation@-100"
        }
      ],
      "explorer/context": [
        {
          "command": "docsview.showPreview",
          "when": "resourceExtname =~ /^\\.(md|markdown|csv|tsv|jsonl|ndjson|svg)$/i",
          "group": "navigation@90"
        },
        {
          "command": "docsview.showPreviewToSide",
          "when": "resourceExtname =~ /^\\.(md|markdown|csv|tsv|jsonl|ndjson|svg)$/i",
          "group": "navigation@91"
        }
      ],
      "commandPalette": [
        {
          "command": "docsview.showPreview",
          "when": "resourceExtname =~ /^\\.(md|markdown|csv|tsv|jsonl|ndjson|svg)$/i"
        },
        {
          "command": "docsview.showPreviewToSide",
          "when": "resourceExtname =~ /^\\.(md|markdown|csv|tsv|jsonl|ndjson|svg)$/i"
        },
        {
          "command": "docsview.showSource",
          "when": "activeCustomEditorId == 'docsview.markdown' || activeCustomEditorId == 'docsview.csv' || activeCustomEditorId == 'docsview.jsonl' || (activeCustomEditorId == 'docsview.image' && resourceExtname =~ /^\\.svg$/i)"
        },
        {
          "command": "docsview.showHistory",
          "when": "resourceExtname =~ /^\\.(md|markdown|csv|tsv|jsonl|ndjson|xlsx|xlsm|docx|pptx|pdf|png|jpg|jpeg|webp|gif|bmp|svg|ico|avif)$/i"
        },
        {
          "command": "docsview.ai.openAssistant",
          "when": "activeCustomEditorId =~ /^docsview\\./"
        },
        {
          "command": "docsview.getViewerState",
          "when": "false"
        },
        {
          "command": "docsview.readDocumentMarkdown",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "DocsView",
      "properties": {
        "docsview.ai.provider": {
          "type": "string",
          "enum": [
            "VS Code",
            "DeepSeek",
            "Kimi",
            "Doubao",
            "Qwen",
            "OpenAI",
            "Ollama",
            "Magpie",
            "CC Switch",
            "OpenAI Compatible"
          ],
          "enumDescriptions": [
            "%config.ai.provider.0%",
            "%config.ai.provider.1%",
            "%config.ai.provider.2%",
            "%config.ai.provider.3%",
            "%config.ai.provider.4%",
            "%config.ai.provider.5%",
            "%config.ai.provider.6%",
            "%config.ai.provider.7%",
            "%config.ai.provider.8%",
            "%config.ai.provider.9%"
          ],
          "default": "VS Code",
          "description": "%config.ai.provider%",
          "scope": "machine"
        },
        "docsview.ai.baseUrl": {
          "type": "string",
          "default": "",
          "description": "%config.ai.baseUrl%",
          "scope": "machine"
        },
        "docsview.ai.model": {
          "type": "string",
          "default": "",
          "description": "%config.ai.model%",
          "scope": "machine"
        },
        "docsview.markdown.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "%config.markdown.scrollSync%"
        },
        "docsview.markdown.fontSize": {
          "type": "number",
          "default": 15,
          "minimum": 12,
          "maximum": 24,
          "description": "%config.markdown.fontSize%"
        },
        "docsview.markdown.lineHeight": {
          "type": "number",
          "default": 1.65,
          "minimum": 1.2,
          "maximum": 2.2,
          "description": "%config.markdown.lineHeight%"
        },
        "docsview.markdown.contentWidth": {
          "type": "string",
          "enum": [
            "fixed",
            "fluid"
          ],
          "enumItemLabels": [
            "Fixed",
            "Adaptive"
          ],
          "default": "fixed",
          "description": "%config.markdown.contentWidth%"
        },
        "docsview.markdown.splitPosition": {
          "type": "string",
          "enum": [
            "sourceLeft",
            "previewLeft"
          ],
          "enumItemLabels": [
            "Source Left, Preview Right",
            "Preview Left, Source Right"
          ],
          "default": "sourceLeft",
          "description": "%config.markdown.splitPosition%"
        },
        "docsview.csv.delimiter": {
          "type": "string",
          "enum": [
            "auto",
            ",",
            ";",
            "\t",
            "|"
          ],
          "enumItemLabels": [
            "Auto",
            "Comma",
            "Semicolon",
            "Tab",
            "Pipe"
          ],
          "default": "auto",
          "description": "%config.csv.delimiter%"
        },
        "docsview.appearance.theme": {
          "type": "string",
          "enum": [
            "editor",
            "github",
            "paper",
            "academic"
          ],
          "enumItemLabels": [
            "Editor",
            "GitHub",
            "Paper",
            "Academic"
          ],
          "default": "editor",
          "description": "%config.appearance.theme%"
        },
        "docsview.appearance.colorScheme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "description": "%config.appearance.colorScheme%"
        },
        "docsview.appearance.invertPages": {
          "type": "boolean",
          "default": false,
          "description": "%config.appearance.invertPages%"
        },
        "docsview.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-cn",
            "en"
          ],
          "enumItemLabels": [
            "Auto",
            "简体中文",
            "English"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "docsview.highlightRowColumn": {
          "type": "boolean",
          "default": true,
          "description": "%config.highlightRowColumn%"
        },
        "docsview.table.lockEditing": {
          "type": "boolean",
          "default": false,
          "description": "%config.table.lockEditing%"
        },
        "docsview.showNotices": {
          "type": "boolean",
          "default": true,
          "description": "%config.showNotices%"
        },
        "docsview.image.loupePosition": {
          "type": "string",
          "enum": [
            "follow",
            "fixed"
          ],
          "enumItemLabels": [
            "Follow Cursor",
            "Fixed Position"
          ],
          "default": "follow",
          "description": "%config.image.loupePosition%"
        },
        "docsview.sidebarPosition": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "enumItemLabels": [
            "Left",
            "Right"
          ],
          "default": "left",
          "description": "%config.sidebarPosition%"
        },
        "docsview.comments.author": {
          "type": "string",
          "default": "",
          "description": "%config.comments.author%"
        },
        "docsview.toolbar": {
          "type": "object",
          "properties": {
            "left": {
              "type": "array",
              "items": { "type": "string" }
            },
            "right": {
              "type": "array",
              "items": { "type": "string" }
            },
            "docActionOrder": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "default": {
            "left": [
              "nav",
              "view",
              "doc:slideMode",
              "doc:focusMode",
              "doc:present",
              "pager",
              "zoom",
              "transform",
              "bbox",
              "cellBar",
              "find",
              "edit",
              "comments",
              "highlight",
              "structure",
              "doc:chart",
              "doc:pivot",
              "ai",
              "doc:bookmark",
              "doc:captureFrame",
              "actions",
              "theme",
              "openApp"
            ],
            "right": []
          },
          "description": "%config.toolbar%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "dev": "node esbuild.mjs --dev && node out/dev-server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node esbuild.mjs --dev && node scripts/smoke.mjs",
    "samples": "node scripts/gen-samples.mjs",
    "vscode:prepublish": "npm run build:prod",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "docx": "^9.15.3",
    "docx-preview": "^0.4.1",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.4",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.3.0",
    "morphdom": "^2.7.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pptx-preview": "^1.0.7",
    "pptxgenjs": "^4.0.1",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "icon": "media/icon.png"
}
